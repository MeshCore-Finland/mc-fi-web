---
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
---

<StarlightPage
  frontmatter={{
    title: 'Ota yhteyttä noden omistajaan',
    description: 'Yhteydenottolomake noden tai tarran tunnisteella.',
    tableOfContents: false,
    pagefind: false,
    prev: false,
    next: false,
  }}
>
  <p>
    Löysitkö MeshCore-noden tai haluatko ottaa yhteyttä sen omistajaan? Voit
    käyttää noden tai tarran tunnistetta yhteydenottoon.
  </p>
  <p id="contact-notice" role="status">
    Lomake on esikatselu. Viestien lähetys ei ole vielä käytössä.
  </p>
  <noscript>
    <p>
      Ota JavaScript käyttöön, jotta linkin tunniste voidaan täyttää
      lomakkeeseen.
    </p>
  </noscript>
  <form id="node-contact-form" aria-describedby="contact-notice">
    <div class="contact-field">
      <label for="node-id">Noden tai tarran tunniste (pakollinen)</label>
      <input
        id="node-id"
        name="nodeId"
        type="text"
        required
        minlength="6"
        maxlength="6"
        pattern="[0-9A-Fa-f]{6}"
        autocomplete="off"
        spellcheck="false"
        placeholder="Esim. 0FF1C3"
        aria-describedby="node-id-help"
      />
      <input id="linked-node-id" name="nodeId" type="hidden" disabled />
      <small id="node-id-help">
        Tunnisteessa on kuusi merkkiä: 0–9 tai A–F.
      </small>
    </div>
    <section id="node-greeting" aria-live="polite" aria-atomic="true" hidden>
      <h2>
        Terveiset toistimen <span id="node-greeting-id"></span> omistajalta
      </h2>
      <p id="node-greeting-text"></p>
    </section>
    <p id="node-lookup-status" role="status"></p>
    <div class="contact-field">
      <label for="contact-name">Nimi</label>
      <input id="contact-name" name="name" type="text" autocomplete="name" />
    </div>
    <div class="contact-field">
      <label for="contact-message">Viesti (pakollinen)</label>
      <textarea
        id="contact-message"
        name="message"
        rows="6"
        required
        aria-describedby="contact-message-help"
      ></textarea>
      <small id="contact-message-help">
        Jätä viestiin yhteystietosi, esimerkiksi puhelinnumero tai
        sähköpostiosoite, jos haluat omistajan vastaavan sinulle.
      </small>
    </div>
    <button type="submit" disabled>
      Lähetys ei vielä käytössä
    </button>
  </form>
</StarlightPage>

<script>
  import { normalizeNodeId } from '../lib/node-contact.mjs';

  const form = document.querySelector<HTMLFormElement>('#node-contact-form');
  const nodeId = document.querySelector<HTMLInputElement>('#node-id');
  const linkedNodeId =
    document.querySelector<HTMLInputElement>('#linked-node-id');
  const help = document.querySelector<HTMLElement>('#node-id-help');
  const greeting = document.querySelector<HTMLElement>('#node-greeting');
  const greetingId = document.querySelector<HTMLElement>('#node-greeting-id');
  const greetingText = document.querySelector<HTMLElement>(
    '#node-greeting-text',
  );
  const status = document.querySelector<HTMLElement>('#node-lookup-status');
  const pathId = window.location.pathname.match(/^\/n\/([^/]+)\/?$/)?.[1];
  let suppliedId = '';

  try {
    suppliedId = (
      pathId !== undefined
        ? decodeURIComponent(pathId)
        : (new URLSearchParams(window.location.search).get('id') ?? '')
    ).trim();
  } catch {
    // Malformed URL encoding leaves the required field available for manual entry.
  }

  const normalizedId = normalizeNodeId(suppliedId);
  if (normalizedId && nodeId && linkedNodeId && help) {
    nodeId.value = normalizedId;
    nodeId.disabled = true;
    // Disabled controls are omitted from FormData; retain the ID for future submission.
    linkedNodeId.value = normalizedId;
    linkedNodeId.disabled = false;
    help.textContent = 'Tunniste on täytetty linkistä eikä sitä voi muokata.';
  } else if (suppliedId && help) {
    help.textContent =
      'Linkin tunniste on virheellinen. Kirjoita kuusi merkkiä: 0–9 tai A–F.';
  }

  let lookupController: AbortController | undefined;
  async function lookupNode() {
    lookupController?.abort();
    if (!nodeId || !greeting || !greetingId || !greetingText || !status) return;
    greeting.hidden = true;
    greetingText.textContent = '';
    const id = normalizeNodeId(nodeId.value);
    if (!id) {
      status.textContent = nodeId.value
        ? 'Kirjoita kuusi merkkiä: 0–9 tai A–F.'
        : '';
      return;
    }
    const controller = new AbortController();
    lookupController = controller;
    status.textContent = 'Haetaan noden tietoja…';
    try {
      const response = await fetch(`/api/node-contact/${id}`, {
        signal: controller.signal,
      });
      if (controller.signal.aborted) return;
      if (response.status === 404) {
        status.textContent = 'Tälle tunnisteelle ei löytynyt noden tietoja.';
        return;
      }
      if (!response.ok) throw new Error('Lookup failed');
      const data = await response.json();
      if (controller.signal.aborted) return;
      if (typeof data.description !== 'string')
        throw new Error('Invalid response');
      greetingText.textContent = data.description;
      greetingId.textContent = id;
      greeting.hidden = false;
      status.textContent = '';
    } catch {
      if (!controller.signal.aborted) {
        status.textContent =
          'Noden tietoja ei voitu hakea. Kokeile myöhemmin uudelleen.';
      }
    }
  }

  nodeId?.addEventListener('input', () => {
    void lookupNode();
  });
  void lookupNode();

  // Keep personal information out of URL query parameters, including on Enter.
  form?.addEventListener('submit', (event) => event.preventDefault());
</script>

<style>
  form {
    display: grid;
    gap: 1.25rem;
    max-width: 36rem;
  }

  .contact-field {
    display: grid;
    gap: 0.4rem;
  }

  label {
    font-weight: 600;
  }

  input:not([type='hidden']),
  textarea {
    width: 100%;
    box-sizing: border-box;
    padding: 0.65rem 0.8rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.4rem;
    background: var(--sl-color-bg);
    color: var(--sl-color-text);
    font: inherit;
  }

  textarea {
    resize: vertical;
  }

  input:disabled {
    background: var(--sl-color-gray-6);
  }

  small {
    color: var(--sl-color-gray-2);
  }

  button {
    justify-self: start;
    padding: 0.65rem 1rem;
    border: 1px solid var(--sl-color-gray-4);
    border-radius: 0.4rem;
    font: inherit;
    cursor: not-allowed;
  }
</style>
