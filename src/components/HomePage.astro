---
import { getRelativeLocaleUrl } from 'astro:i18n';
import StarlightPage from '@astrojs/starlight/components/StarlightPage.astro';
import NetworkStats from './NetworkStats.astro';
import FinlandMap from './FinlandMap.astro';
import { resources, regions } from '../lib/site';
import { defaultLocale } from '../lib/locales';
const locale = Astro.currentLocale ?? defaultLocale;
const t = Astro.locals.t;
---

<StarlightPage
  frontmatter={{
    title: t('app.home.pageTitle'),
    hidePageTitle: true,
    description: t('app.home.intro'),
    template: 'splash',
    tableOfContents: false,
    prev: false,
    next: false,
  }}
  hasSidebar={true}
>
  <div class="home-page not-content">
    <section class="home-hero">
      <div class="hero-copy">
        <h1 id="_top">
          {t('app.home.title')}
          <br />
          <span>{t('app.home.accent')}</span>
        </h1>
        <p class="hero-intro">{t('app.home.intro')}</p>
        <div class="hero-actions">
          <a
            class="button-primary"
            href={getRelativeLocaleUrl(locale, 'guides/getting-started')}
          >
            {t('app.home.start')}
            <span aria-hidden="true">↗</span>
          </a>
          <a class="button-secondary" href={resources.map}>
            {t('app.home.map')}
            <span aria-hidden="true">↗</span>
          </a>
        </div>
      </div>
      <div class="home-map">
        <FinlandMap />
      </div>
    </section>
    <section class="home-paths">
      <div class="section-heading">
        <p class="eyebrow">01 / {t('app.home.startSection')}</p>
        <h2>{t('app.home.next')}</h2>
        <p>{t('app.home.nextIntro')}</p>
      </div>
      <div class="path-grid">
        {[
          {
            number: '01',
            title: t('app.home.guides'),
            text: t('app.home.guidesText'),
            path: 'guides/getting-started',
          },
          {
            number: '02',
            title: t('app.home.repeater'),
            text: t('app.home.repeaterText'),
            path: 'repeaters/name',
          },
          {
            number: '03',
            title: t('app.home.faq'),
            text: t('app.home.faqText'),
            path: 'faq/general',
          },
        ].map((card) => (
          <a class="path-card" href={getRelativeLocaleUrl(locale, card.path)}>
            <span class="card-number">
              {card.number}
              <span aria-hidden="true">↗</span>
            </span>
            <h3>{card.title}</h3>
            <p>{card.text}</p>
          </a>
        ))}
      </div>
    </section>
    <section class="home-activity">
      <div class="section-heading">
        <p class="eyebrow">02 / {t('app.home.networkSection')}</p>
        <h2>{t('app.home.activity')}</h2>
        <p>{t('app.home.activityText')}</p>
        <a class="text-link" href={resources.map}>
          CoreScope <span aria-hidden="true">↗</span>
        </a>
      </div>
      <NetworkStats />
    </section>
    <section class="home-community">
      <div class="section-heading">
        <p class="eyebrow">03 / {t('app.home.communitySection')}</p>
        <h2>{t('app.home.community')}</h2>
        <p>{t('app.home.communityText')}</p>
      </div>
      <div class="community-links">
        <a class="discord-link" href={resources.discord}>
          <span>Mesh Finland Discord</span>
          <strong>{t('app.home.join')} ↗</strong>
        </a>
        <div class="regions">
          {regions.map((region) => (
            <div>
              <h3>{region.name}</h3>
              <a href={region.map}>{t('app.home.regionMap')} ↗</a>
              {region.site && <a href={region.site}>{t('app.home.visit')} ↗</a>}
            </div>
          ))}
        </div>
      </div>
    </section>
    <footer class="home-footer">
      <span>{t('app.home.footer')}</span>
      <a href={resources.official}>{t('app.home.official')} ↗</a>
    </footer>
  </div>
</StarlightPage>

<style>
  /* Reuse Starlight's mobile menu while keeping the homepage full-width on desktop. */
  :global(html:has(.home-page)) {
    --sl-content-width: 67.5rem;
  }
  @media (min-width: 50rem) {
    :global(html:has(.home-page)) {
      --sl-content-inline-start: 0rem;
    }
    :global(html:has(.home-page) .sidebar) {
      display: none;
    }
  }
</style>
