---
import RegionalMap from './RegionMap.tsx';
import { regionMaps, type RegionMapId } from '../lib/region-maps';
import { DEFAULT_REPEATER_BUNDLE_URL } from '../lib/repeater-bundle';
import 'leaflet/dist/leaflet.css';
import './region-map.css';

interface Props {
  region: RegionMapId;
  bundleUrl?: string;
  coverageNote?: string;
}

const {
  region,
  coverageNote,
  bundleUrl = import.meta.env.PUBLIC_REPEATER_BUNDLE_URL ||
    DEFAULT_REPEATER_BUNDLE_URL,
} = Astro.props;
const config = regionMaps[region];
if (!config) throw new Error(`Unknown map region: ${region}`);
const t = Astro.locals.t;
const labels = {
  locations: t('app.regionMap.locations'),
  coverage: t('app.regionMap.coverage'),
  source: t('app.regionMap.source'),
  reset: t('app.regionMap.reset'),
  loading: t('app.regionMap.loading'),
  unavailable: t('app.regionMap.unavailable'),
  empty: t('app.regionMap.empty'),
  count: t('app.regionMap.count'),
  updated: t('app.regionMap.updated'),
  stale: t('app.regionMap.stale'),
  locationsNote: t('app.regionMap.locationsNote'),
  coverageNote: t('app.regionMap.coverageNote'),
  open: t('app.regionMap.open'),
  list: t('app.regionMap.list'),
  zoomIn: t('app.regionMap.zoomIn'),
  zoomOut: t('app.regionMap.zoomOut'),
  noScript: t('app.regionMap.noScript'),
};
---

<RegionalMap
  config={config}
  labels={labels}
  bundleUrl={bundleUrl}
  coverageNote={coverageNote}
  locale={Astro.currentLocale || 'fi'}
  client:visible
/>
