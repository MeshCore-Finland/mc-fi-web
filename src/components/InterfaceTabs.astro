---
interface Props { id: string; methods?: ('web' | 'mobile' | 'cli')[]; }
const { id, methods = ['web', 'mobile', 'cli'] } = Astro.props;
const en = Astro.locals.starlightRoute.lang === 'en';
const labels = { web: en ? 'Web GUI' : 'Verkkokäyttöliittymä', mobile: en ? 'Mobile app' : 'Mobiilisovellus', cli: en ? 'Command line' : 'Komentorivi' };
---
<interface-tabs class="interface-tabs">
  <div class="interface-tablist not-content" role="tablist" aria-label={en ? 'Choose an interface' : 'Valitse käyttötapa'} data-pagefind-ignore>
    {methods.map((method, index) => <button type="button" role="tab" id={`${id}-tab-${method}`} data-method={method} aria-controls={`${id}-panel-${method}`} aria-selected={index === 0 ? 'true' : 'false'} tabindex={index === 0 ? 0 : -1}>{labels[method]}</button>)}
  </div>
  {methods.map((method, index) => <div role="tabpanel" data-method={method} id={`${id}-panel-${method}`} aria-labelledby={`${id}-tab-${method}`} hidden={index !== 0}><slot name={method} /></div>)}
</interface-tabs>
<script>
  const key = 'mcfi-interface';
  class InterfaceTabs extends HTMLElement {
    connectedCallback() {
      if (this.dataset.ready) return;
      this.dataset.ready = 'true';
      const tabs = [...this.querySelectorAll<HTMLButtonElement>('[role="tab"]')];
      const activate = (method: string) => {
        if (!tabs.some(tab => tab.dataset.method === method)) return;
        tabs.forEach(tab => { const active = tab.dataset.method === method; tab.setAttribute('aria-selected', String(active)); tab.tabIndex = active ? 0 : -1; });
        this.querySelectorAll<HTMLElement>('[role="tabpanel"]').forEach(panel => panel.hidden = panel.dataset.method !== method);
      };
      const select = (method: string) => {
        try { localStorage.setItem(key, method); } catch { /* Keep working when storage is unavailable. */ }
        window.dispatchEvent(new CustomEvent('mcfi:interface', { detail: method }));
      };
      window.addEventListener('mcfi:interface', event => activate((event as CustomEvent<string>).detail));
      tabs.forEach((tab, index) => {
        tab.addEventListener('click', () => select(tab.dataset.method!));
        tab.addEventListener('keydown', event => {
          const next = event.key === 'ArrowRight' ? (index + 1) % tabs.length : event.key === 'ArrowLeft' ? (index + tabs.length - 1) % tabs.length : event.key === 'Home' ? 0 : event.key === 'End' ? tabs.length - 1 : -1;
          if (next !== -1) { event.preventDefault(); tabs[next].focus(); select(tabs[next].dataset.method!); }
        });
      });
      let preference = new URLSearchParams(location.search).get('interface');
      if (!preference) { try { preference = localStorage.getItem(key); } catch {} }
      if (preference) { activate(preference); }
    }
  }
  if (!customElements.get('interface-tabs')) customElements.define('interface-tabs', InterfaceTabs);
</script>
