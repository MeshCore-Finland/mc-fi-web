---
import { radioSettings } from '../lib/site';
const t = Astro.locals.t;
const rows = [
  [t('app.radio.preset'), radioSettings.preset],
  [t('app.radio.frequency'), radioSettings.frequency],
  [t('app.radio.bandwidth'), radioSettings.bandwidth],
  ['SF', radioSettings.spreadingFactor],
  ['CR', radioSettings.codingRate],
];
---

<table class="radio-settings">
  <tbody>
    {rows.map(([label, value]) => (
      <tr>
        <th scope="row">{label}</th>
        <td>{value}</td>
      </tr>
    ))}
  </tbody>
</table>
