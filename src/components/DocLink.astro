---
import { getRelativeLocaleUrl } from 'astro:i18n';
import { defaultLocale } from '../lib/locales';

interface Props {
  page: string;
  anchor?: string;
}
const { page, anchor } = Astro.props;
if (!/^[a-z0-9-]+(?:\/[a-z0-9-]+)*$/.test(page)) {
  throw new Error(
    `DocLink expects a document path without a locale or leading slash: ${page}`,
  );
}
const href =
  getRelativeLocaleUrl(Astro.currentLocale ?? defaultLocale, page) +
  (anchor ? '#' + encodeURIComponent(anchor) : '');
---

<a href={href}>
  <slot />
</a>
